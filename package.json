  "scripts": {
    "dev": "bun scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "bun scripts/with-app-env.mjs vite build && bun run db:migrate",
    "db:migrate": "bun scripts/migrate.mjs",
    "build:dev": "bun scripts/with-app-env.mjs vite build --mode development",
    "preview": "bun scripts/with-app-env.mjs vite preview",
    "preview:restart": "bun scripts/preview.mjs restart",
    "preview:stop": "bun scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "bun scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/theme/catalog.test.ts src/lib/theme/layout.test.ts src/lib/blog/wikilink.test.ts src/lib/blog/wiki-suggest.test.ts src/lib/blog/video-embed.test.ts src/lib/attachments/mime.test.ts src/lib/attachments/refs.test.ts src/lib/seo.test.ts src/lib/mcp/handler.test.ts src/lib/release.test.ts src/lib/entrance/core.test.ts src/lib/workspace.test.ts src/lib/obsidian/token-guard.test.ts src/lib/pages/visibility.test.ts src/lib/topics/catalog.test.ts src/lib/updates/core.test.ts && bun test src/lib/hono/app.test.ts",
