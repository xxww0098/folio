{
  "name": "folio",
  "version": "0.1.8",
  "private": false,
  "license": "MIT",
  "description": "折页 Folio — 技术向中文独立博客",
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.4.2",
