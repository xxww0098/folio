# 复制为 .env 后修改。不要把 .env 提交进仓库。
#
#   cp .env.example .env
#   # 生产请换成随机值：openssl rand -hex 32

# 站点对外地址（浏览器访问的 origin，含协议和端口）
# 本机：http://localhost:8011
# 公网：https://blog.example.com   （必须 HTTPS，会话 Cookie 要求安全上下文）
BETTER_AUTH_URL=http://localhost:8011

# 会话签名密钥。生产必须换成足够长的随机串。
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Postgres 密码。不要包含 @ : / # ? 等 URL 保留字符（会写进 DATABASE_URL）。
POSTGRES_PASSWORD=change-me-too

# 映射到宿主机的前端端口
FOLIO_PORT=8011

# 可选。不填则首次启动随机生成邮箱和密码，并打印到 docker compose logs folio
# FOLIO_ADMIN_EMAIL=you@example.com
# FOLIO_ADMIN_PASSWORD=
# FOLIO_ADMIN_NAME=站长

# 镜像版本：latest，或 GitHub Release 的 tag（例如 v0.1.0）
# 升级：./scripts/update-from-release.sh
FOLIO_VERSION=latest

# 可选。对象存储（S3 / R2 / MinIO / 阿里云 OSS）。不填则图片写进 Postgres。
# 控制台「存储」页也可以改，页面上的设置优先。
# FOLIO_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# FOLIO_S3_BUCKET=folio
# FOLIO_S3_REGION=auto
# FOLIO_S3_ACCESS_KEY=
# FOLIO_S3_SECRET_KEY=
# FOLIO_S3_FORCE_PATH_STYLE=true
# FOLIO_S3_PUBLIC_URL=
# FOLIO_S3_PREFIX=folio

