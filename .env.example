# 复制为 .env 后再改。对象存储在控制台「系统 → 设置」里填，不要写在这里。

BETTER_AUTH_URL=http://localhost:8011
BETTER_AUTH_SECRET=change-me-use-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-no-special-chars
FOLIO_PORT=8011
FOLIO_VERSION=latest

# 可选。不填则首次启动随机生成站长账户，看 docker compose logs folio
# FOLIO_ADMIN_EMAIL=you@example.com
# FOLIO_ADMIN_PASSWORD=
# FOLIO_ADMIN_NAME=站长
